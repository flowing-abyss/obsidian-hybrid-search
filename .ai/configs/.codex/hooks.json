{
  "description": "Project-local skill bootstrap and checkout-local CodeGraph prompt context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/inject-superpowers.mjs\"",
            "commandWindows": "node -e \"const {execFileSync,spawnSync}=require('node:child_process');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[root+'/.ai/hooks/inject-superpowers.mjs'],{stdio:'inherit'});process.exit(result.status ?? 1)\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "Loading superpowers skill-check instructions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/codegraph.mjs\" prompt-hook",
            "commandWindows": "node -e \"const {execFileSync,spawnSync}=require('node:child_process');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const result=spawnSync(process.execPath,[root+'/.ai/codegraph.mjs','prompt-hook'],{stdio:'inherit'});process.exit(result.status ?? 1)\"",
            "timeout": 30,
            "statusMessage": "Loading CodeGraph context"
          }
        ]
      }
    ]
  }
}
