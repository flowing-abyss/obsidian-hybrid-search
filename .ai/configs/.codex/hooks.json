{
  "description": "Project-local skill bootstrap and checkout-local CodeGraph prompt context.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/hooks/inject-superpowers.mjs\"",
            "commandWindows": "node -e \"const {execFileSync}=require('node:child_process');const {pathToFileURL}=require('node:url');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();process.argv=[process.execPath,root+'/.ai/hooks/inject-superpowers.mjs'];import(pathToFileURL(process.argv[1]).href)\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "Loading superpowers skill-check instructions"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.ai/codegraph.mjs\" prompt-hook",
            "commandWindows": "node -e \"const {execFileSync}=require('node:child_process');const {pathToFileURL}=require('node:url');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();process.argv=[process.execPath,root+'/.ai/codegraph.mjs','prompt-hook'];import(pathToFileURL(process.argv[1]).href)\"",
            "timeout": 30,
            "statusMessage": "Loading CodeGraph context"
          }
        ]
      }
    ]
  }
}
