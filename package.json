{
  "name": "obsidian-hybrid-search",
  "version": "0.16.4",
  "mcpName": "io.github.flowing-abyss/obsidian-hybrid-search",
  "type": "module",
  "bin": {
    "obsidian-hybrid-search": "./dist/src/cli.js",
    "ohs": "./dist/src/cli.js",
    "obsidian-hybrid-search-mcp": "./dist/src/server.js"
  },
  "scripts": {
    "prepare": "node .ai/prepare.mjs",
    "build": "tsc",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:reranker": "vitest run --config vitest.reranker.config.ts",
    "test:native-recovery-smoke": "node scripts/smoke-native-recovery.mjs",
    "test:e2e-watcher": "vitest run --config vitest.e2e-watcher.config.ts",
    "coverage": "vitest run --coverage",
    "eval": "tsx eval/evaluate.ts",
    "eval:qmd": "tsx eval/evaluate-qmd.ts",
    "eval:benchmark": "tsx eval/benchmark-speed.ts",
    "eval:compare": "tsx eval/compare.ts",
    "eval:prepare-obsidian-help": "tsx eval/prepare-obsidian-help.ts",
    "eval:prepare-evergreen-notes": "tsx eval/prepare-evergreen-notes.ts",
    "eval:prepare-longmem": "tsx eval/prepare-longmemeval.ts",
    "eval:prepare-longmemeval-s": "tsx eval/prepare-longmemeval.ts",
    "eval:quality": "tsx scripts/eval-quality.mjs",
    "eval:speed": "tsx eval/benchmark-speed.ts",
    "eval:speed-profile": "tsx eval/speed-profile.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "preflight": "npm run verify",
    "sync-server-json": "bash scripts/sync-server-json.sh",
    "setup:ai": "node .ai/setup.mjs",
    "codegraph:setup": "node .ai/setup-codegraph.mjs",
    "codegraph": "node .ai/codegraph.mjs",
    "test:ai": "node --test .ai/tests/*.test.mjs .ai/skills/*/scripts/*.test.mjs",
    "test:architecture": "vitest run test/architecture-boundaries.test.ts",
    "verify": "node scripts/verify.mjs",
    "verify:task": "node scripts/verify.mjs --task",
    "verify:ci": "node scripts/verify.mjs --ci",
    "verify:quality": "node scripts/verify.mjs --quality",
    "test:tooling": "node --test scripts/tests/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "search",
    "hybrid-search",
    "semantic-search",
    "fulltext-search",
    "sqlite",
    "mcp"
  ],
  "author": "flowing-abyss",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowing-abyss/obsidian-hybrid-search.git"
  },
  "bugs": {
    "url": "https://github.com/flowing-abyss/obsidian-hybrid-search/issues"
  },
  "homepage": "https://github.com/flowing-abyss/obsidian-hybrid-search#readme",
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    "dist/src",
    "dist/eval",
    "assets/banner.png",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^6.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.12",
    "js-tiktoken": "^1.0.21",
    "onnxruntime-node": "^1.30.0",
    "picocolors": "^1.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.6.2",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.42.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "^4.1.11",
    "@eslint/js": "10.0.1"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "better-sqlite3": true,
    "onnxruntime-node": true,
    "esbuild": true,
    "protobufjs": true,
    "fsevents": false
  },
  "packageManager": "npm@12.2.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  }
}
